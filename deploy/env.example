# Help Desk settings. Placeholders only.
# Copy to .env on a server. Never commit a .env file.
# "change-me" marks a secret the installer replaces. Do not put a real password, token, or key here.
# The GitHub download token is not a variable in this file. docker login stores it outside the repo.

COMPOSE_PROJECT_NAME=helpdesk # namespaces containers, networks, and volumes
HD_ENV=development # production, staging, development, or test; the beta VM uses staging
HD_IMAGE_REGISTRY=ghcr.io/stormywookster # where images are pulled from
HD_IMAGE_TAG=stable # stable, edge, or a pinned X.Y.Z
HD_PUBLIC_URL=http://127.0.0.1:8380 # portal base URL used in email links
HD_DOMAIN=support.example.com # hostname for bundled TLS
HD_ACME_EMAIL=you@example.com # Let's Encrypt contact
HD_HTTP_BIND=127.0.0.1:8380 # published address of the web service
HD_CONSOLE_WEB_ENABLED=false # true serves the Console in a browser
HD_DISPLAY_TIMEZONE=America/New_York # display time zone
HD_MIN_DESKTOP_VERSION=1.0.0 # older desktop apps get HTTP 426
LOG_LEVEL=info # log level
TRUST_PROXY=127.0.0.1,172.16.0.0/12 # proxies whose X-Forwarded-For is trusted
CORS_ALLOWED_ORIGINS=app://console # extra allowed origins
PUBLIC_CORS_ORIGINS= # exact https origins for the future public form; empty means none
IDEMPOTENCY_KEY_TTL_HOURS=24 # how long submission idempotency keys are kept
BRAND_SITE_NAME=Help Desk # first-start site name placeholder
BRAND_COMPANY_NAME=Your Company # first-start company name placeholder
BRAND_PRIMARY_COLOR=#2563EB # first-start color placeholder
PRIVACY_NOTICE_ENABLED=false # first-start privacy notice switch
HD_INTERNAL_IP_ALLOWLIST= # optional IP/CIDR limit for staff routes; empty means off
COOKIE_SECURE=true # must stay true in production
POSTGRES_DB=helpdesk # database name
POSTGRES_USER=helpdesk # bootstrap superuser from the postgres image; creates the roles below. Not the API login.
POSTGRES_PASSWORD=change-me # secret; generated at install
POSTGRES_OWNER_USER=helpdesk_owner # migration login. Owns the schema. Not the API runtime login.
POSTGRES_OWNER_PASSWORD=change-me # secret; generated at install
POSTGRES_APP_USER=helpdesk_app # API login. Owns no tables.
POSTGRES_APP_PASSWORD=change-me # secret; generated at install
DATABASE_URL=postgresql://helpdesk_app:change-me@db:5432/helpdesk # secret; API runtime connection
MIGRATE_DATABASE_URL=postgresql://helpdesk_owner:change-me@db:5432/helpdesk # secret; migration connection
HD_TOKEN_PEPPER=change-me # secret; HMAC key for session and link hashes
HD_DATA_ENCRYPTION_KEY=change-me # secret; reserved for future MFA
ARGON2_MEMORY_KIB=19456 # password hash memory cost
ARGON2_ITERATIONS=2 # password hash iterations
ARGON2_PARALLELISM=1 # password hash parallelism
PASSWORD_MIN_LENGTH=15 # minimum staff password length
SETUP_CODE_TTL_DAYS=7 # first-run setup code lifetime
SESSION_WEB_IDLE_HOURS=12 # browser session idle limit
SESSION_WEB_ABSOLUTE_DAYS=7 # browser session absolute limit
SESSION_NATIVE_IDLE_HOURS=12 # desktop and Android session idle limit
SESSION_NATIVE_ABSOLUTE_DAYS=30 # desktop and Android session absolute limit
LOGIN_MAX_FAILURES_PER_ACCOUNT_IP=10 # failures before an account+IP lockout
LOGIN_LOCKOUT_MINUTES=15 # lockout length
LOGIN_MAX_FAILURES_PER_ACCOUNT_HOUR=50 # failures before an account-wide lockout
SECURE_LINK_LOOKUP_TTL_MINUTES=60 # lookup link lifetime; max 20160 (14 days)
SECURE_LINK_NOTIFICATION_TTL_DAYS=7 # notification link lifetime; max 14
HD_TEST_CLOCK_ENABLED=false # allowed only when HD_ENV=test
CUSTOMER_SESSION_IDLE_MINUTES=120 # customer access session idle limit
CUSTOMER_SESSION_ABSOLUTE_HOURS=24 # customer access session absolute limit
RATE_LIMIT_SUBMIT_PER_IP_HOUR=5 # ticket submissions per IP
RATE_LIMIT_SUBMIT_PER_EMAIL_HOUR=3 # ticket submissions per email
RATE_LIMIT_LOOKUP_PER_IP_HOUR=10 # ticket lookups per IP
RATE_LIMIT_LOOKUP_PER_EMAIL_HOUR=3 # ticket lookups per email
RATE_LIMIT_LOOKUP_PER_REFERENCE_HOUR=5 # ticket lookups per ticket number
RATE_LIMIT_CUSTOMER_MESSAGES_PER_TICKET_HOUR=20 # customer replies per ticket
CAPTCHA_PROVIDER=altcha # altcha, turnstile, or none (none is dev/test only)
ALTCHA_HMAC_KEY=change-me # secret; signs ALTCHA challenges
TURNSTILE_SITE_KEY= # only if CAPTCHA_PROVIDER=turnstile
TURNSTILE_SECRET_KEY= # secret; only if CAPTCHA_PROVIDER=turnstile
EMAIL_TRANSPORT=smtp # smtp or log
SMTP_HOST=smtp.gmail.com # SMTP server
SMTP_PORT=587 # SMTP port
SMTP_SECURITY=starttls # starttls, tls, or none (none is for Mailpit only)
SMTP_USER=you@example.com # sending mailbox
SMTP_PASSWORD=change-me # secret; mailbox password or app password
EMAIL_FROM_ADDRESS=you@example.com # default From address
EMAIL_FROM_NAME=Help Desk # first-start sender display name
EMAIL_MAX_PER_DAY=400 # daily send cap
EMAIL_MAX_PER_MINUTE=20 # per-minute send cap
EMAIL_ALERT_COALESCE_MINUTES=10 # window for merging staff alerts
EMAIL_ALERT_PREVIEW_CHARS=500 # staff-alert preview length; allowed 100-500
EMAIL_TEST_SUBJECT_TAG=[TEST] # subject prefix when HD_ENV is not production
ATTACHMENTS_DIR=/data/attachments # attachment storage inside the volume
ATTACHMENT_HARD_MAX_BYTES=26214400 # ceiling for the admin attachment setting
SCANNER=clamav # clamav, or fake in tests only
CLAMAV_HOST=clamav # clamd host
CLAMAV_PORT=3310 # clamd port
SCAN_TIMEOUT_SECONDS=120 # scan timeout
SCAN_MAX_ATTEMPTS=10 # scan retries
AUTO_CLOSE_CRON=*/15 * * * * # auto-close schedule
BACKUP_CRON=0 3 * * * # nightly backup schedule (ET)
RESTORE_TEST_CRON=0 5 * * 0 # weekly restore-test schedule (ET)
BACKUP_TARGET_DIR=/var/backups/helpdesk # host path for nightly backups
SUPPORT_BUNDLE_DIR= # optional support-bundle folder; empty uses the sudo user's home
RESTIC_REPOSITORY=/backup-target/restic # local restic repository inside the container
BACKUP_OFFSITE_REPOSITORY= # optional off-site copy; empty means local only
RESTIC_PASSWORD=change-me # secret; backup encryption password
AWS_ACCESS_KEY_ID= # secret; only with an S3/B2 off-site target
AWS_SECRET_ACCESS_KEY= # secret; only with an S3/B2 off-site target
BACKUP_KEEP_DAILY=7 # daily snapshots to keep
BACKUP_KEEP_WEEKLY=4 # weekly snapshots to keep
BACKUP_KEEP_MONTHLY=12 # monthly snapshots to keep
TZ=America/New_York # cron time zone inside containers

# Dev and test only. Not used by a production server.
MAILPIT_API_URL=http://127.0.0.1:8025
E2E_BASE_URL=http://127.0.0.1:8380
PRISM_PORT=4010
