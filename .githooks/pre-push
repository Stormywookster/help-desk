#!/bin/sh
# Refuse every push to main, including a force-push or a branch delete.
# Installed when npm ci runs the prepare script (core.hooksPath=.githooks).
set -eu

remote_name=${1:-}
remote_url=${2:-}
refused=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: refusing push to main." >&2
    echo "pre-push: remote ${remote_name} (${remote_url}); local ${local_ref}; remote ref ${remote_ref}." >&2
    echo "pre-push: open a pull request. Never push or force-push to main." >&2
    refused=1
  fi
done

if [ "$refused" -ne 0 ]; then
  exit 1
fi
exit 0
